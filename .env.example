# ==============================================================================
# RETINA EDUCATIONAL CONSULTANCY - EMAIL BACKEND CONFIGURATION
# ==============================================================================

# Destination email where all student inquiries are sent:
COMPANY_INQUIRY_EMAIL=consultretina8@gmail.com

# ------------------------------------------------------------------------------
# OPTION 1: Gmail SMTP Setup (Recommended & Standard)
# ------------------------------------------------------------------------------
# To generate a Gmail App Password:
# 1. Sign in to your Google Account (consultretina8@gmail.com).
# 2. Go to: https://myaccount.google.com/security
# 3. Enable 2-Step Verification if not already enabled.
# 4. Search for "App passwords" or visit https://myaccount.google.com/apppasswords
# 5. Create an App password (e.g., named "Retina Website").
# 6. Paste the 16-character generated password below without spaces.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=consultretina8@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
SMTP_FROM="Retina Admissions Desk" <consultretina8@gmail.com>

# ------------------------------------------------------------------------------
# OPTION 2: Custom SMTP / Other Email Providers (e.g. Brevo, SendGrid, Zoho)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-account-user
# SMTP_PASS=your-smtp-key
# SMTP_FROM="Retina Inquiries" <admissions@retinaconsultancy.com>
